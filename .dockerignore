# Keep the docker build context small. Only amplifier_library/ and lakehoused/
# are COPY'd, but ignore noise inside them too.

# VCS
.git
.gitignore
.gitmodules
.gitattributes

# Python build / cache
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.ruff_cache
**/.pyright_cache
**/.venv
**/*.egg-info
**/build
**/dist

# Webapp — backend image doesn't need it
webapp/

# Notebooks, docs, related projects, guides
notebooks/
guides/
related-projects/
**/docs/

# Editor / OS
.vscode/
.idea/
**/.DS_Store
*.code-workspace

# Runtime / state
**/.lakehoused
**/.amplified
.data/
.smoke_test_data/
logs/
*.log
*.log.jsonl

# Docker / CI
Dockerfile
.dockerignore
.github/

# Top-level markdown / config not needed in image
README.md
DEPLOYMENT.md
EVENTS.md
LAN.md
SECURITY.md
AGENTS.PROJECT.md
LICENSE
Makefile
ruff.toml
uv.lock
